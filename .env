# ==============================================================================
# SAAS ENVIRONMENT CONFIGURATION
# ==============================================================================

# App URL (Render, Railway, or Vercel production URL, or localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 1. AUTH (Clerk or Supabase) - Slide 6 / Slide 8
# If left empty, the project automatically runs in DEMO / OAUTH SIMULATION MODE
# NextAuth / Clerk Keys:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Or Supabase Keys:
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. STRIPE BILLING & SUBSCRIPTION - Slide 5 / Slide 8
# Get these from https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
STRIPE_PRO_PRICE_ID=price_sample_pro_monthly

# 3. MONITORING & SENTRY - Slide 7 / Slide 8
NEXT_PUBLIC_SENTRY_DSN=
